-- 2. Role ESP Logic
-- ==========================================
local function GetPlayerRoleColor(player)
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")

    local function hasTool(toolName)
        return (character and character:FindFirstChild(toolName)) or (backpack and backpack:FindFirstChild(toolName))
    end

    if hasTool("Knife") then
        return Color3.fromRGB(255, 45, 45)
    elseif hasTool("Gun") then
        return Color3.fromRGB(45, 140, 255)
    else
        return Color3.fromRGB(60, 230, 100)
    end
end

local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local highlight = player.Character:FindFirstChild("PROTO_ESP")
            if Settings.ESP then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "PROTO_ESP"
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = player.Character
                end
                local roleColor = GetPlayerRoleColor(player)
                highlight.FillColor = roleColor
                highlight.OutlineColor = roleColor
            else
                if highlight then
                    highlight:Destroy()
                end
            end
        end
    end
end

