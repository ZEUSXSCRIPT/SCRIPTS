-- 3. Fixed Auto Farm (Coins & Candy)
-- ==========================================
local function FindCoinContainer()
    for _, child in ipairs(workspace:GetChildren()) do
        local container = child:FindFirstChild("CoinContainer")
        if container then
            return container
        end
    end
    return workspace:FindFirstChild("CoinContainer", true)
end

local function GetValidCoinPart(item)
    if VisitedCoins[item] then return nil end

    local visual = item:FindFirstChild("CoinVisual")
    if visual and visual:IsA("BasePart") then
        if visual.Transparency > 0.5 then return nil end
        return visual
    end

    if item:IsA("BasePart") then
        if item.Transparency > 0.5 then return nil end
        return item
    elseif item:IsA("Model") then
        local part = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
        if part and part.Transparency <= 0.5 then
            return part
        end
    end
    return nil
end

local function GetNearestCollectible(container)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart or not container then return nil, nil, nil end

    local nearestPart = nil
    local nearestItem = nil
    local shortestDist = math.huge

    for _, item in ipairs(container:GetChildren()) do
        local targetPart = GetValidCoinPart(item)
        if targetPart then
            local dist = (rootPart.Position - targetPart.Position).Magnitude
            if dist < shortestDist and dist < 300 then
                shortestDist = dist
                nearestPart = targetPart
                nearestItem = item
            end
        end
    end
    return nearestPart, nearestItem, shortestDist
end

-- Noclip & Zero Velocity Stabilization
RunService.Stepped:Connect(function()
    if (Settings.AutoFarmCoins or Settings.AutoFarmCandy) and LocalPlayer.Character then
        local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.Velocity = Vector3.zero
            rootPart.RotVelocity = Vector3.zero
        end
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

