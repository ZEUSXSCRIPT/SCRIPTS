    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = Btn

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(70, 50, 90)
    BtnStroke.Thickness = 1.2
    BtnStroke.Parent = Btn

    Btn.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        if Settings[settingKey] then
            Btn.Text = text .. " : ON"
            Btn.BackgroundColor3 = Color3.fromRGB(255, 105, 0)
            Btn.TextColor3 = Color3.fromRGB(18, 12, 24)
            BtnStroke.Color = Color3.fromRGB(255, 160, 60)
        else
            Btn.Text = text .. " : OFF"
            Btn.BackgroundColor3 = Color3.fromRGB(30, 22, 38)
            Btn.TextColor3 = Color3.fromRGB(220, 220, 220)
            BtnStroke.Color = Color3.fromRGB(70, 50, 90)
            if CurrentTween then
                CurrentTween:Cancel()
                CurrentTween = nil
            end
        end
    end)
end

